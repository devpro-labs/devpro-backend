{
  "title": "Warehouse Inventory Control API",
  "description": "Build a PostgreSQL REST API for warehouse inventory. Implement POST /products to create products with sku, name, and stock. Implement GET /products/:id to fetch a product by id. Implement PATCH /products/:id/stock to update stock. Implement GET /products/low-stock/:threshold to list products where stock is less than or equal to threshold. Return 404 if product is not found.",
  "difficulty": "PRO",
  "tags": [
    "postgresql",
    "inventory",
    "backend",
    "crud"
  ],
  "entryFile": "index",
  "services": [
    "REST",
    "POSTGRES"
  ],
  "keys": {
    "PORT": "***",
    "PG_URI": "***"
  },
  "timeLimitSeconds": 7,
  "memoryLimitMB": 256,
  "cpuLimit": 0.5,
  "testCases": [
    {
      "input": {
        "sku": "MUG-100",
        "name": "Ceramic Mug",
        "stock": 8,
        "qid" : 1
      },
      "expectedOutput": {
        "sku": "MUG-100",
        "name": "Ceramic Mug",
        "stock": 8,
        "qid": 1
      },
      "expectedStatus": 201,
      "isHidden": false,
      "method": "POST",
      "endpoint": "/products"
    },
    {
      "input": {},
      "expectedOutput": {
        "sku": "MUG-100",
        "name": "Ceramic Mug",
        "stock": 8
      },
      "expectedStatus": 200,
      "isHidden": false,
      "method": "GET",
      "endpoint": "/products/1",
      "usePreviousId": true
    },
    {
      "input": {
        "stock": 3
      },
      "expectedOutput": {
        "stock": 3
      },
      "expectedStatus": 200,
      "isHidden": false,
      "method": "PATCH",
      "endpoint": "/products/1/stock",
      "usePreviousId": true
    },
    {
      "input": {},
      "expectedOutput": {
        "count": 1
      },
      "expectedStatus": 200,
      "isHidden": false,
      "method": "GET",
      "endpoint": "/products/low-stock/5"
    },
    {
      "input": {},
      "expectedOutput": {
        "error": "Product not found"
      },
      "expectedStatus": 404,
      "isHidden": true,
      "method": "GET",
      "endpoint": "/products/2"
    },
    {
      "input": {
        "stock": 10
      },
      "expectedOutput": {
        "error": "Product not found"
      },
      "expectedStatus": 404,
      "isHidden": true,
      "method": "PATCH",
      "endpoint": "/products/2/stock"
    },
    {
      "input":{
        "sku" : "MUG-101",
        "name" : "Glass Mug",
        "stock" : 5,
        "qid" : 2
      },
      "expectedOutput":{
        "sku" : "MUG-101",
        "name" : "Glass Mug",
        "stock" : 5,
        "qid" : 2
      },
      "expectedStatus": 201,
      "isHidden": true,
      "method": "POST",
      "endpoint": "/products"
    }
  ]
}
