{
  "title": "Clinic Appointment Booking API",
  "description": "Build a MongoDB-backed REST API for a clinic. Implement POST /appointments to create an appointment with patientName, doctorName, slotTime, and status (default: scheduled). Implement GET /appointments/:id to fetch by ObjectId. Implement PATCH /appointments/:id/status to update status to confirmed or cancelled. Implement GET /health. Return 404 when appointment is not found.",
  "difficulty": "CASUAL",
  "tags": [
    "mongodb",
    "backend",
    "express",
    "health-check"
  ],
  "entryFile": "index",
  "services": [
    "REST",
    "MONGODB"
  ],
  "keys": {
    "PORT": "***",
    "MONGO_URI": "***"
  },
  "timeLimitSeconds": 6,
  "memoryLimitMB": 256,
  "cpuLimit": 0.5,
  "testCases": [
    {
      "input": {
        "patientName": "Aisha Khan",
        "doctorName": "Dr. Roy",
        "slotTime": "2026-05-03T09:30:00Z",
        "qid" : 1
      },
      "expectedOutput": {
        "patientName": "Aisha Khan",
        "doctorName": "Dr. Roy",
        "status": "scheduled",
        "qid": 1
      },
      "expectedStatus": 201,
      "isHidden": false,
      "method": "POST",
      "endpoint": "/appointments"
    },
    {
      "input": {},
      "expectedOutput": {
        "patientName": "Aisha Khan",
        "doctorName": "Dr. Roy",
        "status": "scheduled"
      },
      "expectedStatus": 200,
      "isHidden": false,
      "method": "GET",
      "endpoint": "/appointments/1",
      "usePreviousId": true
    },
    {
      "input": {
        "status": "confirmed"
      },
      "expectedOutput": {
        "status": "confirmed"
      },
      "expectedStatus": 200,
      "isHidden": false,
      "method": "PATCH",
      "endpoint": "/appointments/1/status",
      "usePreviousId": true
    },
    {
      "input": {},
      "expectedOutput": {
        "message": "Health OK"
      },
      "expectedStatus": 200,
      "isHidden": false,
      "method": "GET",
      "endpoint": "/health"
    },
    {
      "input": {},
      "expectedOutput": {
        "error": "Appointment not found"
      },
      "expectedStatus": 404,
      "isHidden": false,
      "method": "GET",
      "endpoint": "/appointments/2"
    },
    {
      "input": {
        "status": "cancelled"
      },
      "expectedOutput": {
        "error": "Appointment not found"
      },
      "expectedStatus": 404,
      "isHidden": true,
      "method": "PATCH",
      "endpoint": "/appointments/2/status"
    },
    {
      "input": {},
      "expectedOutput": {
        "error": "Appointment not found"
      },
      "expectedStatus": 404,
      "isHidden": true,
      "method": "GET",
      "endpoint": "/appointments/3"
    },
    {
      "input": {
        "status": "confirmed"
      },
      "expectedOutput": {
        "error": "Appointment not found"
      },
      "expectedStatus": 404,
      "isHidden": true,
      "method": "PATCH",
      "endpoint": "/appointments/3/status"
    }
  ]
}
