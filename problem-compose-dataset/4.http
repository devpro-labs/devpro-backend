{
  "title": "Basic REST API with Redis Cache and PostgreSQL",
  "description": "Build a REST API using PostgreSQL as the primary database and Redis as a caching layer. Create a GET /users/:id endpoint that first checks Redis cache. If data exists in Redis, return it. Otherwise fetch from PostgreSQL, store it in Redis with TTL of 60 seconds, and return the result. Also implement a health check endpoint GET /health.",
  "difficulty": "ENGINEER",
  "tags": ["redis", "postgres", "backend", "caching", "database"],
  "entryFile": "index",
  "services": ["REST", "REDIS", "POSTGRES"],
  "keys": {
    "PORT": 3000,
    "REDIS_HOST": "redis",
    "REDIS_PORT": 6379,
    "POSTGRES_HOST": "postgres",
    "POSTGRES_PORT": 5432,
    "POSTGRES_USER": "user",
    "POSTGRES_PASSWORD": "password",
    "POSTGRES_DB": "db"
  },
  "timeLimitSeconds": 5,
  "memoryLimitMB": 512,
  "cpuLimit": 1.0,

  "testCases": [
    {
      "input": {},
      "expectedOutput": {
        "id": 1,
        "name": "John Doe"
      },
      "expectedStatus": 200,
      "isHidden": false,
      "method": "GET",
      "endpoint": "/users/1"
    },
    {
      "input": {},
      "expectedOutput": {
        "error": "User not found"
      },
      "expectedStatus": 404,
      "isHidden": true,
      "method": "GET",
      "endpoint": "/users/999"
    },
    {
      "input": {},
      "expectedOutput": {
        "message": "Health OK"
      },
      "expectedStatus": 200,
      "isHidden": true,
      "method": "GET",
      "endpoint": "/health"
    }
  ]
}

