Content-Disposition: form-data; name="problem"
Content-Type: application/json

{
  "title": "Redis-Based API Rate Limiter",
  "description": "Build a REST API with Redis-based rate limiting middleware. Each user (identified by IP or userId header) can make a maximum of 5 requests per 60 seconds. If the limit is exceeded, return HTTP 429 with an appropriate error message. Use Redis to track request counts with expiry (TTL). Do NOT use in-memory counters.",
  "difficulty": "ENGINEER",
  "tags": ["redis", "rate-limiting", "backend", "middleware"],
  "entryFile": "index",
  "services": ["REST", "REDIS"],
  "keys": {
    "PORT": 3000,
    "REDIS_HOST": "redis",
    "REDIS_PORT": 6379,
    "RATE_LIMIT": 5,
    "WINDOW_SECONDS": 60
  },
  "timeLimitSeconds": 5,
  "memoryLimitMB": 512,
  "cpuLimit": 1.0,

  "testCases": [
    {
      "input": {},
      "expectedOutput": {
        "message": "Request successful"
      },
      "expectedStatus": 200,
      "isHidden": false,
      "method": "GET",
      "endpoint": "/api/data"
    },
    {
      "input": {},
      "expectedOutput": {
        "message": "Request successful"
      },
      "expectedStatus": 200,
      "isHidden": false,
      "method": "GET",
      "endpoint": "/api/data"
    },
    {
      "input": {},
      "expectedOutput": {
        "error": "Too many requests. Please try again later."
      },
      "expectedStatus": 429,
      "isHidden": true,
      "method": "GET",
      "endpoint": "/api/data"
    },
    {
      "input": {},
      "expectedOutput": {
        "message": "Health OK"
      },
      "expectedStatus": 200,
      "isHidden": true,
      "method": "GET",
      "endpoint": "/health"
    }
  ]
}

