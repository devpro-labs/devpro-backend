{
  "title": "User Management REST API (CRUD)",
  "description": "Build a REST API to manage users using CRUD operations. The API should allow creating, retrieving, updating, and deleting users. Each user should have an id, name, email, and age. Data can be stored in memory or a simple database.",
  "difficulty": "EASY",
  "tags": ["rest-api", "crud", "backend"],
  "entryFile": "index",
  "services": ["REST"],
  "keys": {
    "PORT": 3000
  },
  "timeLimitSeconds": 5,
  "memoryLimitMB": 512,
  "cpuLimit": 1.0,

  "testCases": [
    {
      "input": {
        "name": "Alice",
        "email": "alice@example.com",
        "age": 22
      },
      "expectedOutput": {
        "message": "User created successfully",
        "name": "Alice",
        "email": "alice@example.com",
        "age": 22
      },
      "expectedStatus": 201,
      "isHidden": false,
      "method": "POST",
      "endpoint": "/users"
    },
    {
      "input": {},
      "expectedOutput": {
        "email": "alice@example.com"
      },
      "expectedStatus": 200,
      "isHidden": false,
      "method": "GET",
      "endpoint": "/users/1"
    },
    {
      "input": {
        "age": 23
      },
      "expectedOutput": {
        "message": "User updated successfully",
        "age": 23
      },
      "expectedStatus": 200,
      "isHidden": false,
      "method": "PUT",
      "endpoint": "/users/1"
    },

    {
      "input": {},
      "expectedOutput": {
        "error": "User not found"
      },
      "expectedStatus": 404,
      "isHidden": true,
      "method": "GET",
      "endpoint": "/users/999"
    },
    {
      "input": {},
      "expectedOutput": {
        "message": "User deleted successfully"
      },
      "expectedStatus": 200,
      "isHidden": true,
      "method": "DELETE",
      "endpoint": "/users/1"
    },
    {
      "input": {},
      "expectedOutput": {
        "error": "User not found"
      },
      "expectedStatus": 404,
      "isHidden": true,
      "method": "DELETE",
      "endpoint": "/users/1"
    },
    {
      "input": {
        "email": "invalid-email"
      },
      "expectedOutput": {
        "error": "Invalid email format"
      },
      "expectedStatus": 400,
      "isHidden": true,
      "method": "POST",
      "endpoint": "/users"
    },
    {
      "input": {},
      "expectedOutput": {
        "error": "No users found"
      },
      "expectedStatus": 200,
      "isHidden": true,
      "method": "GET",
      "endpoint": "/users"
    }
  ]
}
