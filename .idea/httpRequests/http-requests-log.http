{
  "title": "JWT Authentication REST API",
  "description": "Build a REST API with JWT-based authentication. Users should be able to register, login, and access protected routes using a valid token.",
  "difficulty": "MEDIUM",
  "tags": ["auth", "jwt", "rest-api", "backend"],
  "entryFile": "index",
  "services": ["AUTH", "REST"],
  "keys": {
    "JWT_SECRET": "secret123",
    "PORT": 3000
  },
  "timeLimitSeconds": 5,
  "memoryLimitMB": 512,
  "cpuLimit": 1.0,
  "testCases": [
    {
      "input": {
        "email": "test@example.com",
        "password": "password123"
      },
      "expectedOutput": {
        "message": "User registered successfully"
      },
      "expectedStatus": 201,
      "isHidden": false,
      "method": "POST",
      "endpoint": "/auth/register"
    },
    {
      "input": {
        "email": "test@example.com",
        "password": "password123"
      },
      "expectedOutput": {
        "token": "jwt-token"
      },
      "expectedStatus": 200,
      "isHidden": true,
      "method": "POST",
      "endpoint": "/auth/login"
    },
    {
      "input": {},
      "expectedOutput": {
        "error": "Unauthorized"
      },
      "expectedStatus": 401,
      "isHidden": true,
      "method": "GET",
      "endpoint": "/api/protected"
    }
  ]
}
