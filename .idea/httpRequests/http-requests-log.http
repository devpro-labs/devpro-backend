        "value": "devan"
      },
      "expectedStatus": 200,
      "isHidden": false,
      "method": "GET",
      "endpoint": "/store/username"
    },
    {
      "input": {},
      "expectedOutput": {
        "message": "Key deleted successfully"
      },
      "expectedStatus": 200,
      "isHidden": false,
      "method": "DELETE",
      "endpoint": "/store/username"
    },
    {
      "input": {},
