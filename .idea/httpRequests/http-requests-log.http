      },
      "expectedStatus": 404,
      "isHidden": true,
      "method": "DELETE",
      "endpoint": "/store/unknown"
    },
    {
      "input": {},
      "expectedOutput": {
        "keys": []
      },
      "expectedStatus": 200,
      "isHidden": true,
