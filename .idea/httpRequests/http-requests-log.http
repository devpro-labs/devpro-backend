{
  "title": "Redis Key-Value Store API",
  "description": "Build a REST API using Redis as the primary data store. The API should allow setting, retrieving, deleting, and listing key-value pairs. Each key should map to a string value. Use Redis commands for storage instead of in-memory arrays.",
  "difficulty": "MEDIUM",
  "tags": ["redis", "backend", "rest-api", "docker"],
  "entryFile": "index",
  "services": ["REST", "REDIS"],
  "keys": {
    "PORT": 3000,
    "REDIS_HOST": "redis",
    "REDIS_PORT": 6379
  },
  "timeLimitSeconds": 5,
  "memoryLimitMB": 512,
  "cpuLimit": 1.0,

  "testCases": [
    {
      "input": {
        "key": "username",
        "value": "devan"
      },
      "expectedOutput": {
        "message": "Key set successfully",
        "key": "username",
        "value": "devan"
      },
      "expectedStatus": 201,
      "isHidden": false,
      "method": "POST",
      "endpoint": "/store"
    },
    {
      "input": {},
      "expectedOutput": {
        "key": "username",
        "value": "devan"
      },
      "expectedStatus": 200,
      "isHidden": false,
      "method": "GET",
      "endpoint": "/store/username"
    },
    {
      "input": {},
      "expectedOutput": {
        "message": "Key deleted successfully"
      },
      "expectedStatus": 200,
      "isHidden": false,
      "method": "DELETE",
      "endpoint": "/store/username"
    },
    {
      "input": {},
      "expectedOutput": {
        "error": "Key not found"
      },
      "expectedStatus": 404,
      "isHidden": true,
      "method": "GET",
      "endpoint": "/store/unknown"
    },
    {
      "input": {},
      "expectedOutput": {
        "error": "Key not found"
      },
      "expectedStatus": 404,
      "isHidden": true,
      "method": "DELETE",
      "endpoint": "/store/unknown"
    },
    {
      "input": {},
      "expectedOutput": {
        "keys": []
      },
      "expectedStatus": 200,
      "isHidden": true,
      "method": "GET",
      "endpoint": "/store"
    }
  ]
}
